      "voiceName": "Elderon (recorded by hand)",
      "lines": [
        {
          "text": "Your objective: understand how one treaty set the world on fire.",
          "start": 0.06,
          "end": 4.84
        },
        {
          "text": "Learn what the Treaty of Versailles demanded of Germany.",
          "start": 5.2,
          "end": 9.18
        },
        {
          "text": "Learn how those terms broke a nation, and left its people desperate.",
          "start": 9.88,
          "end": 14.56
        },
        {
          "text": "Learn how that desperation carried Adolf Hitler to power.",
          "start": 15.2,
          "end": 19.48
        },
        {
          "text": "And learn how it ended — with German tanks crossing into Poland.",
          "start": 20.26,
          "end": 25.66
        },
        {
          "text": "Do you accept the mission?",
          "start": 26.64,
          "end": 28.26
        }
      ]
    },
